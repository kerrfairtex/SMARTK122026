{
    "name": "bbnihs/smartcampus",
    "description": "BBNIHS Application Layer (additive to RosarioSIS)",
    "type": "project",
    "license": "MIT",
    "authors": [
        {
            "name": "Kerr Fairtex",
            "email": "kerrfairtex@gmail.com"
        }
    ],
    "require": {
        "php": ">=8.1",
        "ext-pdo": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "BBNIHS\\": "bbnihs/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "BBNIHS\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    }
}
